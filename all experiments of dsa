Practical No. 8
Course Outcome: CO2
Aim: Write a program to implement Double Ended Queue (Deque).
Theory: A Double Ended Queue (Deque) is a generalized queue that allows insertion and deletion at both the front and the rear ends, effectively combining the behaviors of a stack and a queue. It can be implemented using an array with two pointers, front and rear, supporting four operations: insertFront, insertRear, deleteFront, and deleteRear.
Algorithm:
1. Start
2. insertFront(VALUE): If deque is full, print "Overflow"; else move front pointer backward and insert VALUE
3. insertRear(VALUE): If deque is full, print "Overflow"; else advance rear pointer and insert VALUE
4. deleteFront(): If deque is empty, print "Underflow"; else remove element at front and advance front pointer
5. deleteRear(): If deque is empty, print "Underflow"; else remove element at rear and decrement rear pointer
6. display(): Print all elements from front to rear
7. Stop
Program:
/* Practical 8: Double Ended Queue (Deque) using Array (CO2) */
#include <stdio.h>
#define MAX 5
int arr[MAX];
int front = -1, rear = -1;
 
int isFull()
{
    return (rear == MAX - 1);
}
 
int isEmpty()
{
    return (front == -1);
}
 
/* Insert at Front */
void insertFront()
{
    int value;
 
    if (front == 0)
    {
        printf("Insertion at Front Not Possible!\n");
        return;
    }
 
    printf("Enter element: ");
    scanf("%d", &value);
 
    if (isEmpty())
    {
        front = rear = 0;
    }
    else
    {
        front--;
    }
 
    arr[front] = value;
 
    printf("%d inserted at Front.\n", value);
}
 
/* Insert at Rear */
void insertRear()
{
    int value;
 
    if (isFull())
    {
        printf("Deque Overflow!\n");
        return;
    }
 
    printf("Enter element: ");
    scanf("%d", &value);
 
    if (isEmpty())
    {
        front = rear = 0;
    }
    else
    {
        rear++;
    }
 
    arr[rear] = value;
 
    printf("%d inserted at Rear.\n", value);
}
 
/* Delete from Front */
void deleteFront()
{
    if (isEmpty())
    {
        printf("Deque Underflow!\n");
        return;
    }
 
    printf("%d deleted from Front.\n", arr[front]);
 
    if (front == rear)
    {
        front = rear = -1;
    }
