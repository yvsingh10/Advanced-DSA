    /* Quick Sort */
    for (int i = 0; i < n; i++) arr[i] = original[i];
    comparisons = 0; movements = 0;
    start = clock(); quickSort(arr, 0, n - 1); end = clock();
    writeRow(out, "Quick Sort", elapsedMs(start, end), comparisons, movements,
              "O(n log n)", "O(n log n)", "O(n^2)", "O(log n)", "No");
 
    /* Heap Sort */
    for (int i = 0; i < n; i++) arr[i] = original[i];
    comparisons = 0; movements = 0;
    start = clock(); heapSort(arr, n); end = clock();
    writeRow(out, "Heap Sort", elapsedMs(start, end), comparisons, movements,
              "O(n log n)", "O(n log n)", "O(n log n)", "O(1)", "No");
 
    /* Counting Sort */
    for (int i = 0; i < n; i++) arr[i] = original[i];
    comparisons = 0; movements = 0;
    start = clock(); countingSort(arr, n); end = clock();
    writeRow(out, "Counting Sort", elapsedMs(start, end), comparisons, movements,
              "O(n+k)", "O(n+k)", "O(n+k)", "O(n+k)", "Yes");
 
    /* Radix Sort */
    for (int i = 0; i < n; i++) arr[i] = original[i];
    comparisons = 0; movements = 0;
    start = clock(); radixSort(arr, n); end = clock();
    writeRow(out, "Radix Sort", elapsedMs(start, end), comparisons, movements,
              "O(d(n+k))", "O(d(n+k))", "O(d(n+k))", "O(n+k)", "Yes");
 
    /* Bucket Sort */
    for (int i = 0; i < n; i++) arr[i] = original[i];
    comparisons = 0; movements = 0;
    start = clock(); bucketSort(arr, n); end = clock();
    writeRow(out, "Bucket Sort", elapsedMs(start, end), comparisons, movements,
              "O(n+k)", "O(n+k)", "O(n^2)", "O(n+k)", "Yes");
 
    fprintf(out, "\nSummary:\n");
    fprintf(out, "For the given input, execution time and operation counts are listed above.\n");
    fprintf(out, "Distribution sorts (Counting/Radix/Bucket) perform best on bounded-range\n");
    fprintf(out, "positive integers, while comparison sorts (Merge/Quick/Heap) offer general-\n");
    fprintf(out, "purpose O(n log n) performance regardless of data distribution.\n");
    fprintf(out, "Report generated successfully.\n");
 
    fclose(out);
    printf("\nComparison completed. Report written to %s\n", outfile);
    return 0;
}
